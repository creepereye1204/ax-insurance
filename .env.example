# LLM 선택: ollama (로컬 GPU, 무료) | anthropic (Claude API, 유료)
LLM_PROVIDER=ollama

# Ollama
OLLAMA_MODEL=gemma4:12b-it-qat

# Claude (LLM_PROVIDER=anthropic 일 때만 필요)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# 임베딩 모델 (바꾸면 db/init.sql 의 vector 차원도 맞춰야 함)
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384

# 청킹
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# DB 계정 (운영 배포 시 반드시 변경)
POSTGRES_PASSWORD=change-me

# 포트 (호스트 기준, localhost 전용)
API_PORT=8030
DB_PORT=55440
CORE_PORT=8031
GATEWAY_PORT=8032
